{
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*firebase-adminsdk*.json)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Edit(./.claude/**)"
    ],
    "ask": ["git push*", "npm install*", "eas*", "vercel*"],
    "blockReadsOutsideWorkingDirectories": true
  }
}
